# Copy to .env for local dev (gitignored). Required for Area Radar map UI.
VITE_FIREBASE_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=

# Browser Maps JavaScript API key (Google Cloud Console → APIs → Maps JavaScript API).
