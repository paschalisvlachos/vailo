# Copy to .env.staging for local staging builds, or set these as GitHub Actions secrets.
VITE_APP_ENV=staging

# Firebase web app config (Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=vailo-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vailo-staging
VITE_FIREBASE_STORAGE_BUCKET=vailo-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Public URL of the deployed staging site (for guest portal links / QR codes)
VITE_GUEST_PORTAL_ORIGIN=https://vailo-staging.web.app

# Optional: Maps key if you test Area Radar locally against staging
VITE_GOOGLE_MAPS_API_KEY=

# Seed script credentials (only used by npm run seed:staging — mock data fallback)
STAGING_ADMIN_EMAIL=admin@staging.vailo.app
STAGING_ADMIN_PASSWORD=StagingAdmin123!
STAGING_OWNER_EMAIL=owner@staging.vailo.app
STAGING_OWNER_PASSWORD=StagingOwner123!

# Clone script (npm run clone:staging) — paths to service account JSON files
# GOOGLE_APPLICATION_CREDENTIALS_PRODUCTION=/path/to/vailoapp-497113-key.json
# GOOGLE_APPLICATION_CREDENTIALS_STAGING=/path/to/vailo-staging-key.json
