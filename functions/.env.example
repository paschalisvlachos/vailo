GOOGLE_MAPS_API_KEY=
BILLING_BQ_TABLE=
BILLING_BQ_LOCATION=EU
GEMINI_API_KEY=
# Google AI Studio API key (starts with AIza…). Create at https://aistudio.google.com/apikey
# Do NOT paste OAuth tokens (AQ.…), Firebase web keys alone, or service-account credentials.
RESEND_WEBHOOK_SECRET=
PLATFORM_ADMIN_EMAILS=
GITHUB_STAGING_SYNC_TOKEN=
# Guest ID encryption: use Secret Manager in production (firebase functions:secrets:set GUEST_ID_DOCUMENT_ENCRYPTION_KEY).
# Do NOT add GUEST_ID_DOCUMENT_ENCRYPTION_KEY here — it conflicts with defineSecret() on deploy.
# For local emulator only, put the same key in functions/.secret.local (gitignored).
